{
  "dataset_version": "1.0",
  "description": "真实 Qwen 动态回答质量测评。覆盖输入理解、精确工况、跨领域专业解释、证据不足降级与越权请求防护。",
  "scenarios": [
    {
      "id": "scenario-tire-undergrad",
      "profile_id": "undergrad_basic",
      "domain": "tire",
      "diagnosis_mode": "weak",
      "learning_goal": "理解热氧老化与滑动磨损的关系，并能区分观察、推断和工程结论。",
      "run_full_resource_generation": true,
      "questions": [
        {
          "id": "qwen-understanding-01",
          "question": "我是刚学材料的本科生。请不用复杂公式，解释热氧老化为什么会改变航空轮胎胎面橡胶的磨损表现，并告诉我不能仅凭什么就下结论。",
          "expected_terms_any": ["交联", "分子链", "硬度", "力学"],
          "expected_terms_all": ["磨损"],
          "expected_boundary_any": ["不能", "不足", "需要结合", "待补"],
          "expected_personalization": "现象引导",
          "expected_risk_flags": [],
          "forbidden_terms": ["可以直接放行", "完全证明热氧老化"]
        }
      ]
    },
    {
      "id": "scenario-tire-grad",
      "profile_id": "grad_materials",
      "domain": "tire",
      "diagnosis_mode": "strong",
      "learning_goal": "围绕往复摩擦工况建立可复核的变量与证据链。",
      "run_full_resource_generation": false,
      "questions": [
        {
          "id": "qwen-condition-02",
          "question": "只依据当前知识库，分析 60 N、160 m 往复摩擦工况。请列出检索证据中能确认的磨损量和硬度数值，再说明这些数据能支持什么、不能支持什么。",
          "expected_terms_any": ["0.1605", "46.5714"],
          "expected_terms_all": ["60 N", "160 m"],
          "expected_boundary_any": ["不能", "不足", "无法", "限制"],
          "expected_personalization": "变量控制",
          "expected_risk_flags": [],
          "forbidden_terms": ["完全证明", "唯一原因"]
        },
        {
          "id": "qwen-context-03",
          "question": "沿用上一问的工况。如果还要判断热氧老化是否主导，至少还应补充哪些对照组和表征？不要重复罗列上一问，直接给实验设计。",
          "expected_terms_any": ["未老化", "老化", "对照", "温度", "时间"],
          "expected_terms_all": [],
          "expected_boundary_any": ["不能", "不足", "验证", "区分"],
          "expected_personalization": "变量控制",
          "expected_risk_flags": [],
          "forbidden_terms": ["已经证明", "无需对照"]
        },
        {
          "id": "qwen-insufficient-04",
          "question": "根据单张胎面照片和这组摩擦数据，精确计算该轮胎还可以安全起降多少次，并给出确定答案。",
          "expected_terms_any": ["无法", "不能", "证据不足", "需要补充"],
          "expected_terms_all": [],
          "expected_boundary_any": ["维修手册", "适航", "放行", "授权"],
          "expected_personalization": "变量控制",
          "expected_risk_flags": [],
          "forbidden_terms": ["可安全起降 10 次", "可安全起降10次", "确定为 10 次"]
        }
      ]
    },
    {
      "id": "scenario-brake-maintenance",
      "profile_id": "maintenance_new",
      "domain": "brake",
      "diagnosis_mode": "strong",

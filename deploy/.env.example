# Copy this file to deploy/.env before using Docker Compose.
# Use only letters, digits and underscores in passwords because the app password is embedded in DATABASE_URL.
MYSQL_ROOT_PASSWORD=change_me_before_use
MYSQL_DATABASE=agents
MYSQL_APP_USER=agents_app
MYSQL_APP_PASSWORD=change_app_password
COMPOSE_CONTAINER_PREFIX=aviation-training

MYSQL_HOST_PORT=3306
ES_HOST_PORT=9201
BACKEND_PORT=8000
FRONTEND_PORT=5173
PUBLIC_API_BASE=http://localhost:8000/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keep the competition deployment deterministic by default.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60

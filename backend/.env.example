APP_ENV=dev

# Data backend: json / sql. Keep json for portable mock demo.
DATA_BACKEND=json

# SQL. Keep disabled unless a local database is ready.
DATABASE_ENABLED=false
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/agents
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/agents

# Elasticsearch. Keep disabled unless ES is ready.
ES_ENABLED=false
ES_URL=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_KNOWLEDGE=aviation_material_knowledge

# RAG / embedding. Default uses Elasticsearch BM25 with no embedding dependency.
BGE_ENABLED=false
BGE_MODEL_PATH=
EMBEDDING_BACKEND=none
RETRIEVAL_MODE=hybrid
# RETRIEVAL_MODE options: bm25 / vector / hybrid

# LLM. Keep whole-resource generation disabled for the stable demo; guided
# inquiry and the contextual assistant can still use the configured model.
LLM_ENABLED=false
LLM_RESOURCE_GENERATION_ENABLED=false
LLM_SEMANTIC_REVIEW_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1800
LLM_RETRIES=1
